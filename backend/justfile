default:
    @just --list

dev:
    docker compose -f tests/compose.yml up -d --wait
    - uv run fastapi dev app/main.py
    docker compose -f tests/compose.yml down

test *args:
    docker compose -f tests/compose.yml up -d --wait
    uv run alembic upgrade head
    -uv run pytest {{ args }}
    docker compose -f tests/compose.yml down

lint:
    uvx ruff check && uvx ruff format --check

fix:
    uvx ruff check --fix && uvx ruff format

up:
    docker compose -f tests/compose.yml up -d

down:
    docker compose -f tests/compose.yml down

logs *args:
    docker compose -f tests/compose.yml logs -f {{ args }}

migrate:
    uv run alembic upgrade head

migration name:
    uv run alembic revision --autogenerate -m "{{ name }}"

sync:
    uv sync

db-up:
    docker compose -f compose.dev.yml up -d --wait

db-start:
    docker compose -f compose.dev.yml start

db-stop:
    docker compose -f compose.dev.yml stop

db-down:
    docker compose -f compose.dev.yml down

db-logs *args:
    docker compose -f compose.dev.yml logs -f {{ args }}

db-reset:
    docker compose -f compose.dev.yml down -v

db-rows:
    docker exec -it okd-postgres-dev psql -U postgres -c "SELECT document_title, category, page_number, permalink FROM knowledgebase LIMIT 25;"

db-cols:
    docker exec -it okd-postgres-dev psql -U postgres -c "\d knowledgebase"

run:
    uv run uvicorn app.main:app --reload

log-rows:
    docker exec -it okd-postgres-dev psql -U postgres -c "SELECT session_id, user_email, question FROM oneknowledgedoor_log LIMIT 5;"
